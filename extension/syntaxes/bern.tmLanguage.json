{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bern",
  "scopeName": "source.bern",
  "fileTypes": ["brn"],
  "patterns": [
    { "include": "#pragma" },
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#character" },
    { "include": "#number" },
    { "include": "#import-alias" },
    { "include": "#word-operator" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#qualified-call" },
    { "include": "#function-definition" },
    { "include": "#function-call" },
    { "include": "#variable" },
    { "include": "#operator" },
    { "include": "#object" }
  ],
  "repository": {
    "pragma": {
      "name": "meta.preprocessor.pragma.bern",
      "match": "(\\{--!)\\s*([a-z][a-z-]*)\\s*(!--\\})",
      "captures": {
        "1": { "name": "punctuation.definition.pragma.begin.bern" },
        "2": { "name": "keyword.other.pragma.bern" },
        "3": { "name": "punctuation.definition.pragma.end.bern" }
      }
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.bern",
          "match": "//.*$"
        },
        {
          "name": "comment.line.double-dash.bern",
          "match": "--.*$"
        },
        {
          "name": "comment.block.bern",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.bern",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.bern",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.bern",
          "match": "\\\\."
        }
      ]
    },
    "character": {
      "name": "string.quoted.single.bern",
      "match": "'[^'\\\\]'"
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.float.bern",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.bern",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keyword": {
      "name": "keyword.control.bern",
      "match": "\\b(def|return|returns|such-that|retorna|tal-que|lambda|be|recebe|when|if|else|then|loop|for|in|do|end|print|import|as|case|is|adt|iterative|fmap|foreign|input|keys|read_file|write_file|get_host_machine|get_current_dir)\\b"
    },
    "word-operator": {
      "name": "keyword.operator.word.bern",
      "match": "\\b(is-greater-or-equal|is-less-or-equal|is-greater|is-less|not-equals|divided-by|typeof|length|and-do|plus|minus|negate|times|modulo|equals|concat|union|intersect|difference|and|or|not|maior-ou-igual|menor-ou-igual|maior-que|menor-que|dividido-por|tipo-de|tamanho|e-faca|mais|menos|negativo|vezes|resto|igual|diferente|concatenar|uniao|intersecao|diferenca|e|ou|nao)\\b"
    },
    "import-alias": {
      "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_/]*)\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control.import.bern" },
        "2": { "name": "entity.name.namespace.bern" },
        "3": { "name": "keyword.control.import.bern" },
        "4": { "name": "entity.name.alias.bern" }
      }
    },
    "constant": {
      "name": "constant.language.bern",
      "match": "\\b(true|false)\\b"
    },
    "function-definition": {
      "match": "\\b(def)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "keyword.control.bern" },
        "2": { "name": "entity.name.function.bern" }
      }
    },
    "qualified-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_/]*)\\s*:\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "entity.name.namespace.bern" },
        "2": { "name": "entity.name.function.bern" }
      }
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
      "captures": {
        "1": { "name": "entity.name.function.bern" }
      }
    },
    "variable": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
      "captures": {
        "1": { "name": "variable.other.assignment.bern" }
      }
    },
    "object": {
      "name": "meta.object.bern",
      "begin": "\\#{",
      "end": "\\}#",
      "patterns": [
        {
          "name": "variable.other.property.bern",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.bern",
          "match": "\\)\\|"
        },
        {
          "name": "keyword.operator.set.bern",
          "match": "(</>|<>|<\\||\\|>)"
        },
        {
          "name": "keyword.operator.type.bern",
          "match": "(::|:>)"
        },
        {
          "name": "keyword.operator.arrow.bern",
          "match": "->"
        },
        {
          "name": "keyword.operator.lambda.bern",
          "match": "\\\\"
        },
        {
          "name": "keyword.operator.comparison.bern",
          "match": "(==|!=|>=|<=|>|<)"
        },
        {
          "name": "keyword.operator.logical.bern",
          "match": "(&&|\\|\\|)"
        },
        {
          "name": "keyword.operator.assignment.bern",
          "match": "(:=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.bern",
          "match": "[+\\-*/%]"
        }
      ]
    }
  }
}
