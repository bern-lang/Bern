-- Bindings Definitions

def get_raylib_path() do
    os = get_host_machine()
    cwd = get_current_dir()
    if os == "mingw64" || os == "mingw32" then
        path = cwd <> "/lib/vendor/raylib/windows/raylib.dll"
        return replace(path, "/", "\\")
    else if os == "darwin" then
        return cwd <> "/lib/vendor/raylib/macos/libraylib.550.dylib"
    else
        return cwd <> "/lib/vendor/raylib/linux/libraylib.so.550"
    end
end

RAYLIB_PATH = get_raylib_path()
"RAYLIB_PATH: " <> RAYLIB_PATH

