*/

import core
import math

RL_VERSION_MAJOR = 5
RL_VERSION_MINOR = 5
RL_VERSION_PATCH = 0
RL_VERSION = "5.5"

RL_PI = 3.14159265358979323846
RL_DEG2RAD = (RL_PI / 180.0)
RL_RAD2DEG = (180.0 / RL_PI)


-- Vector Type (adt) - using Float for C compatibility (32-bit)
adt Vector = Vector2 Float Float | Vector3 Float Float Float | Vector4 Float Float Float Float

-- Quaternion Type (adt) - using Float for C compatibility
adt Quaternion = Quaternion Float Float Float Float

-- Matrix Type (adt)
adt Matrix = Matrix [Double]  -- 4x4 matrix represented as a flat list

-- Color Type (adt)
adt Color = Color Byte Byte Byte Byte

-- Rectangle Type (adt) - using Float for C compatibility
adt Rectangle = Rectangle Float Float Float Float

-- Image Type (adt) - using proper C integer types
adt Image = Image Int Int Int Int  
-- void *data, int width, int height, int mipmaps, int format

-- Texture Type (adt) - unsigned int id, int width, height, mipmaps, format
adt Texture = Texture Int Int Int Int Int  
-- id (unsigned int), width, height, mipmaps, format

-- Texture2D and TextureCubemap (aliases to Texture)
Texture2D = Texture
TextureCubemap = Texture

-- RenderTexture Type (adt) - unsigned int id, Texture texture, Texture depth
adt RenderTexture = RenderTexture Int Texture Texture  
-- id (unsigned int), texture, depth

RenderTexture2D = RenderTexture

-- NPatchInfo Type (adt)
adt NPatchInfo = NPatchInfo Rectangle Int Int Int Int Int  
-- source, left, top, right, bottom, layout

-- GlyphInfo Type (adt)
adt GlyphInfo = GlyphInfo Int Int Int Int Image  
-- value (codepoint), offsetX, offsetY, advanceX, image

-- Font Type (adt)
adt Font = Font Int Int Int Texture2D List List 
-- baseSize, glyphCount, glyphPadding, texture, recs, glyphs

-- Camera3D Type (adt) - Vector3 position, Vector3 target, Vector3 up, float fovy, int projection
adt Camera3D = Camera3D Vector Vector Vector Float Int  
-- position, target, up, fovy, projection

-- Camera type fallback
Camera = Camera3D

-- Camera2D Type (adt) - Vector2 offset, Vector2 target, float rotation, float zoom
adt Camera2D = Camera2D Vector Vector Float Float  
-- offset, target, rotation, zoom

-- Mesh Type (adt)
-- vertexCount, triangleCount (simplified - full implementation would need pointers)
adt Mesh = Mesh Int Int

-- Shader Type (adt)
-- id, locs array
adt Shader = Shader Int List

-- MaterialMap Type (adt) - Texture2D texture, Color color, float value
adt MaterialMap = MaterialMap Texture2D Color Float

-- Material Type (adt)
-- shader, maps, params (4 floats)
adt Material = Material Shader List List

-- Transform Type (adt)
-- translation, rotation, scale
adt Transform = Transform Vector Quaternion Vector

-- BoneInfo Type (adt)
-- name, parent
adt BoneInfo = BoneInfo String Int

-- Model Type (adt)
-- transform, meshCount, materialCount (simplified)
adt Model = Model Matrix Int Int

-- ModelAnimation Type (adt)
-- boneCount, frameCount, bones, name
adt ModelAnimation = ModelAnimation Int Int [BoneInfo] String

-- Ray Type (adt)
-- position, direction
adt Ray = Ray Vector Vector

-- RayCollision Type (adt) - bool hit, float distance, Vector3 point, Vector3 normal
adt RayCollision = RayCollision Bool Float Vector Vector

-- BoundingBox Type (adt)
-- min, max
adt BoundingBox = BoundingBox Vector Vector

-- Wave Type (adt)
-- frameCount, sampleRate, sampleSize, channels
adt Wave = Wave Int Int Int Int

-- AudioStream Type (adt)
-- sampleRate, sampleSize, channels
adt AudioStream = AudioStream Int Int Int

-- Sound Type (adt)
-- stream, frameCount
adt Sound = Sound AudioStream Int

-- Music Type (adt)
-- stream, frameCount, looping, ctxType
adt Music = Music AudioStream Int Bool Int

-- VrDeviceInfo Type (adt) - int hRes, int vRes, float hScreenSize, float vScreenSize, 
-- float eyeToScreenDistance, float lensSeparationDistance, float interpupillaryDistance, 
-- float lensDistortionValues[4], float chromaAbCorrection[4]
adt VrDeviceInfo = VrDeviceInfo Int Int Float Float Float Float Float List List

-- VrStereoConfig Type (adt)
-- projection, viewOffset, leftLensCenter, rightLensCenter, 
-- leftScreenCenter, rightScreenCenter, scale, scaleIn
adt VrStereoConfig = VrStereoConfig List List List List List List List List

-- FilePathList Type (adt)
-- capacity, count, paths
adt FilePathList = FilePathList Int Int [String]

-- AutomationEvent Type (adt)
-- frame, type, params
adt AutomationEvent = AutomationEvent Int Int [Int]

-- AutomationEventList Type (adt)
-- capacity, count, events
adt AutomationEventList = AutomationEventList Int Int [AutomationEvent]


