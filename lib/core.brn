-- Bern Standard Library

-- Map: Apply a function to each element of a list
-- Tail-recursive: builds the result in reverse with O(1) prepends, then
-- reverses once at the end. O(n) time and constant Bern-level stack depth.
def map(xs, f) -> map_acc(xs, f, [])
def map_acc([], f, acc) -> reverse_list(acc)
def map_acc([head|tail], f, acc) -> map_acc(tail, f, [f(head)] <> acc)

-- Filter: Keep elements where predicate returns true
def filter(xs, f) -> filter_acc(xs, f, [])
def filter_acc([], f, acc) -> reverse_list(acc)
def filter_acc([head|tail], f, acc) do
    if (f(head)) then
        return filter_acc(tail, f, [head] <> acc)
    else
        return filter_acc(tail, f, acc)
    end
end

-- Fold left: Reduce a list from the left
def foldl([], acc, f) -> acc
def foldl([head|tail], acc, f) -> foldl(tail, f(acc, head), f)

-- Fold right: Reduce a list from the right
def foldr([], acc, f) -> acc
def foldr([head|tail], acc, f) -> f(head, foldr(tail, acc, f))

-- Sum all elements in a list
def sum(list) -> foldl(list, 0, \acc, x -> acc + x)

-- Product of all elements in a list
def product(list) -> foldl(list, 1, \acc, x -> acc * x)

-- Reverse a list
-- Tail-recursive accumulator: each [head] <> acc is an O(1) prepend, so the
-- whole reverse is O(n) instead of the previous O(n^2) (which appended to the
-- growing side on every step).
def reverse_list(xs) -> reverse_list_acc(xs, [])
def reverse_list_acc([], acc) -> acc
def reverse_list_acc([head|tail], acc) -> reverse_list_acc(tail, [head] <> acc)

-- Reverse a set
def reverse_set({}) -> {}
def reverse_set({head|tail}) -> reverse_set(tail) <> {head}

-- General reverse function based on type
def reverse(x) do
    if (::x == "List") then
        return reverse_list(x)
    else if (::x == "Set") then
            return reverse_set(x)
    else 
        "Reverse function not supported for this type."
    end
end
-- Take first n elements
def take(n, xs) -> take_acc(n, xs, [])
def take_acc(0, _, acc) -> reverse_list(acc)
def take_acc(_, [], acc) -> reverse_list(acc)
def take_acc(n, [head|tail], acc) -> take_acc(n - 1, tail, [head] <> acc)

-- Drop first n elements
def drop(0, list) -> list
def drop(_, []) -> []
def drop(n, [_|tail]) -> drop(n - 1, tail)

-- Get head of list
def head([h|_]) -> h
def head([]) -> error("head: empty list")

-- Get tail of list
def tail([_|t]) -> t
def tail([]) -> error("tail: empty list")

-- Check if list is empty
def is_empty([]) -> true
def is_empty(_) -> false

-- Any: Check if any element satisfies predicate
def any([], f) -> false
def any([head|tail], f) do
    if (f(head)) then
        return true
    else
        return any(tail, f)
    end
end

-- All: Check if all elements satisfy predicate
def all([], f) -> true
def all([head|tail], f) do
    if (f(head)) then
        return all(tail, f)
    else
        return false
    end
end

-- Find: Return first element matching predicate; returns false when not found
def find([], f) -> false
def find([head|tail], f) do
    if (f(head)) then
        return head
    else
        return find(tail, f)
    end
end

-- Zip two lists together
def zip(xs, ys) -> zip_acc(xs, ys, [])
def zip_acc([], _, acc) -> reverse_list(acc)
def zip_acc(_, [], acc) -> reverse_list(acc)
def zip_acc([h1|t1], [h2|t2], acc) -> zip_acc(t1, t2, [[h1, h2]] <> acc)

-- ZipWith: Combine two lists with a function
def zip_with(xs, ys, f) -> zip_with_acc(xs, ys, f, [])
def zip_with_acc([], _, f, acc) -> reverse_list(acc)
def zip_with_acc(_, [], f, acc) -> reverse_list(acc)
def zip_with_acc([h1|t1], [h2|t2], f, acc) -> zip_with_acc(t1, t2, f, [f(h1, h2)] <> acc)

-- Range: Create a list from start to end (inclusive)
-- Abstraction for [x..y]
def range(start, end) -> [start..end]

-- Minimum of a list
def min([]) -> error("min: empty list")
def min([x]) -> x
def min([head|tail]) do
    tailMin = min(tail)
    if (head < tailMin) then
        return head
    else
        return tailMin
    end
end

-- Maximum of a list
def max([]) -> error("max: empty list")
def max([x]) -> x
def max([head|tail]) do
    tailMax = max(tail)
    if (head > tailMax) then
        return head
    else
        return tailMax
    end
end

-- Compose two functions without requiring closures
def compose(f, g, x) -> f(g(x))

-- Identity function
def id(x) -> x

-- errors-as-values: test whether a value is a recoverable runtime error.
def is_error(x) -> ::x == "Error"
-- Although string literals return normally, there is
-- a print() function in the core library for explicit printing.
def print(x) -> id(x)

-- TypeOf function: returns the type of the argument as a string
-- Abstraction for built in type retrieval
def type_of(x) -> ::x

-- Length function for strings, lists, and sets
-- Abstraction for built in length retrieval
def len(x) -> :>x

-- Constant function: always returns the first argument
def const(x, _) -> x

-- Flip: swap arguments of a binary function (no closures)
def flip(f, x, y) -> f(y, x)

-- Convert string to integer using pattern matching
def char_to_digit('0') -> 0
def char_to_digit('1') -> 1
def char_to_digit('2') -> 2
def char_to_digit('3') -> 3
def char_to_digit('4') -> 4
def char_to_digit('5') -> 5
def char_to_digit('6') -> 6
def char_to_digit('7') -> 7
def char_to_digit('8') -> 8
def char_to_digit('9') -> 9
def char_to_digit(_) -> error("char_to_digit: not a digit")

def append([], y) -> y
def append([head|tail], y) -> [head] <> append(tail, y)

def to_int(s) do
    def helper([], acc) -> acc
    def helper([head|tail], acc) do
        digit = char_to_digit(head)
        newAcc = acc * 10 + digit
        return helper(tail, newAcc)
    end
    return helper(s, 0)
end

def to_double(s) do
    def helper([], acc, _) -> acc
    def helper(['.'|tail], acc, _) -> helper(tail, acc, 1)
    def helper([head|tail], acc, 0) do
        digit = char_to_digit(head)
        newAcc = acc * 10 + digit
        return helper(tail, newAcc, 0)
    end
    def helper([head|tail], acc, divisor) do
        digit = char_to_digit(head)
        newAcc = acc + (digit * 1.0) / (divisor * 10)
        return helper(tail, newAcc, divisor * 10)
    end
    return helper(s, 0.0, 0)
end

def double_to_int(d) -> d / 1.0
def int_to_double(n) -> n * 1.0

-- get the index of an element in a list or set.
def index_of(x, target) do
    if (::x == "List") then
        return index_of_list(x, target)
    else if (::x == "Set") then
            return index_of_set(x, target)
    else 
        return -1
    end
end

def index_of_list([], _) -> -1
def index_of_list([head|tail], target) do
    if (head == target) then
        return 0
    else
        idx = index_of_list(tail, target)
        if (idx == -1) then
            return -1
        else
            return idx + 1
        end
    end
end

def index_of_set({}, _) -> -1
def index_of_set({head|tail}, target) do
    if (head == target) then
        return 0
    else
        idx = index_of_set(tail, target)
        if (idx == -1) then
            return -1
        else
            return idx + 1
        end
    end
end